cfg = dict(DEFAULTS)

print = functools.partial(print, flush=True)  # progress shows up when piped


def die(msg, code=1):
    print(f"send2kodi: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(f"send2kodi: {msg}", file=sys.stderr)


def read_config(path):
    """KEY=VALUE lines, shell style: comments, blank lines, optional quotes."""
    values = {}
    try:
        with open(path) as f:
            for n, line in enumerate(f, 1):
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                key, sep, value = line.partition("=")
                key, value = key.strip().removeprefix("export "), value.strip()
                if not sep or key not in DEFAULTS:
                    print(f"send2kodi: {path}:{n}: ignoring '{line}'",
                          file=sys.stderr)
                    continue
                if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
                    value = value[1:-1]
                values[key] = value
    except FileNotFoundError:
        pass
    return values


def truthy(value):
    return value.lower() in ("1", "yes", "true", "on")


# ------------------------------------------------------------------- kodi --

class KodiError(Exception):
    """Kodi turned a call down, e.g. because a player stopped meanwhile."""


class Unreachable(Exception):
    """Kodi didn't answer at all."""


def rpc(method, params=None):
    body = {"jsonrpc": "2.0", "id": 1, "method": method}
    if params is not None:
        body["params"] = params
    req = urllib.request.Request(
        f"http://{cfg['KODI_HOST']}:{cfg['KODI_PORT']}/jsonrpc",
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"},
    )
    if cfg["KODI_USER"] or cfg["KODI_PASS"]:
        token = base64.b64encode(
            f"{cfg['KODI_USER']}:{cfg['KODI_PASS']}".encode()).decode()
        req.add_header("Authorization", f"Basic {token}")
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            resp = json.load(r)
    except urllib.error.HTTPError as e:
        if e.code == 401:
            die(f"Kodi at {cfg['KODI_HOST']} rejected the login; "
                f"set KODI_USER and KODI_PASS in {CONFIG_PATH}")
        die(f"Kodi at {cfg['KODI_HOST']}: HTTP {e.code} {e.reason}")
    except OSError as e:
        raise Unreachable(
            f"cannot reach Kodi at {cfg['KODI_HOST']}:{cfg['KODI_PORT']} ({e}).\n"
            "  Is it on, and is Settings > Services > Control > "
            "'Allow remote control via HTTP' enabled?") from None
    if "error" in resp:
        raise KodiError(f"{method} failed: {resp['error']}")
    return resp["result"]


@functools.cache
def has_addon(addonid):
    result = rpc("Addons.GetAddons", {"type": "xbmc.python.pluginsource",
                                      "enabled": True})
    return any(a["addonid"] == addonid for a in result.get("addons", []))


# ------------------------------------------------------------ local files --

@functools.cache
def kodi_ip():
    """KODI_HOST may be a hostname; the server checks clients by address."""
    try:
        return socket.gethostbyname(cfg["KODI_HOST"])
    except OSError as e:
        die(f"cannot resolve {cfg['KODI_HOST']}: {e}")


def local_ip():
    """The address of the interface that routes to Kodi."""
    if cfg["SERVE_IP"]:
        return cfg["SERVE_IP"]
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.connect((kodi_ip(), int(cfg["KODI_PORT"])))
        return s.getsockname()[0]


def quote(name):
    """For URLs; file names needn't be valid UTF-8."""
    return urllib.parse.quote(name, errors="surrogateescape")


class FileHandler(BaseHTTPRequestHandler):
    """Serves the registered folders only, to Kodi only, with Range support.

    A folder asked for itself answers with a list of its files, the way a
    web server lists a directory. That is how Kodi looks for the subtitles
    next to a video, and reads a slideshow.
    """

    folders = {}     # "/<token>/<n>/" -> {name: absolute path}
    fetched = set()  # paths of the files Kodi has asked for

    def log_message(self, fmt, *args):
        pass

    def do_HEAD(self):
        self.serve(body=False)

    def do_GET(self):
        self.serve(body=True)

    def serve(self, body):
        asked = urllib.parse.unquote(self.path, errors="surrogateescape")
        folder, _, name = asked.rpartition("/")
        files = self.folders.get(folder + "/")
        if (self.client_address[0] != kodi_ip() or files is None
                or name and name not in files):
            self.send_error(404)
            return
        if not name:
            self.send_listing(files, body)
            return
        if body:
            self.fetched.add(asked)
        path = files[name]
        size = os.path.getsize(path)
        start, end = 0, size - 1
        m = re.fullmatch(r"bytes=(\d*)-(\d*)", self.headers.get("Range", ""))
        if m and m.group(1):
            start = int(m.group(1))
            end = min(int(m.group(2)), size - 1) if m.group(2) else size - 1
        elif m and m.group(2):  # suffix range: last N bytes
            start = max(size - int(m.group(2)), 0)
        if start > end:
            self.send_response(416)
            self.send_header("Content-Range", f"bytes */{size}")
            self.end_headers()
            return
        self.send_response(206 if m else 200)
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Type", mimetypes.guess_type(path)[0]
                         or "application/octet-stream")
        self.send_header("Content-Length", str(end - start + 1))
        if m:
            self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        self.end_headers()
        if not body:
            return
        try:
            with open(path, "rb") as f:
                f.seek(start)
                left = end - start + 1
                while left > 0:
                    chunk = f.read(min(left, 1 << 16))
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    left -= len(chunk)
        except (BrokenPipeError, ConnectionResetError):
            pass  # Kodi drops connections whenever it seeks

    def send_listing(self, files, body):
        """Kodi takes a link for a file when its text is its decoded href."""
        links = "".join(f'<a href="{quote(name)}">{html.escape(name, False)}</a>\n'
                        for name in files)
        page = ('<!DOCTYPE html>\n<html><head><meta charset="utf-8"></head>'
                f"<body>\n{links}</body></html>\n").encode(errors="surrogateescape")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=UTF-8")
        self.send_header("Content-Length", str(len(page)))
        self.end_headers()
        if body:
            self.wfile.write(page)


class Server:
    """Started on the first local file; one random token per run."""

    def __init__(self):
        self.httpd = None
        self.token = secrets.token_urlsafe(16)
        self.extras = 0  # subtitles served along with videos

    def folder(self, files):
        """Serve {name: path} as a folder of its own; returns its URL."""
        if self.httpd is None:
            ip = local_ip()
            try:
                self.httpd = ThreadingHTTPServer(
                    (ip, int(cfg["SERVE_PORT"])), FileHandler)
            except OSError:  # port taken (e.g. another send2kodi): pick any
                self.httpd = ThreadingHTTPServer((ip, 0), FileHandler)
            self.httpd.daemon_threads = True
            threading.Thread(target=self.httpd.serve_forever, daemon=True).start()
            self.prefix = f"http://{ip}:{self.httpd.server_port}/{self.token}/"
        n = len(FileHandler.folders)
        FileHandler.folders[f"/{self.token}/{n}/"] = {
            name: os.path.abspath(path) for name, path in files.items()}
        return f"{self.prefix}{n}/"

    def url_for(self, path, extras=()):
        """The URL of a file, in a folder with the extras (its subtitles)."""
        name = os.path.basename(path)
        files = {name: path}
        for extra in extras:
            files.setdefault(os.path.basename(extra), extra)
        self.extras += len(files) - 1
        return self.folder(files) + quote(name)

    def owns(self, url):
        return self.httpd is not None and url.startswith(self.prefix)

    def wait_fetched(self, url, timeout=15):
        """Until Kodi has asked for a file, or for timeout seconds."""
        path = urllib.parse.unquote(urllib.parse.urlparse(url).path,
                                    errors="surrogateescape")
        deadline = time.monotonic() + timeout
        while path not in FileHandler.fetched and time.monotonic() < deadline:
            time.sleep(0.2)


# ---------------------------------------------------------------- targets --

def is_url(target):
    return re.match(r"^https?://", target, re.I) is not None


def is_kodi_url(target):
    """Other URLs (smb://, nfs://, rtsp://, plugin://...) Kodi opens itself."""
    return (re.match(r"^[a-z][a-z0-9+.-]*://", target, re.I) is not None
            and not is_url(target))


def extension(path):
    return os.path.splitext(path)[1].lower()


def natural(text):
    """Sort key that puts "Episode 2" before "Episode 10"."""
    return [int(part) if i % 2 else part.casefold()
            for i, part in enumerate(re.split(r"(\d+)", text))]


def plural(n, what):
    return f"{n} {what}{'' if n == 1 else 's'}"


def lines(text):
    """One target per line, as in text/uri-list: blank lines and # comments
    don't count."""
    return [line for line in (raw.strip().strip("\0") for raw in text.splitlines())
            if line and not line.startswith("#")]


def media_in(folder):
    """The media in a folder and its subfolders, in natural order: its videos
    and songs, or its pictures if it has neither."""
    found = {"video": [], "audio": [], "image": []}
    for root, dirs, files in os.walk(folder):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        for name in files:
            if not name.startswith(".") and extension(name) in MEDIA:
                found[MEDIA[extension(name)]].append(os.path.join(root, name))
    sent = found["video"] + found["audio"] or found["image"]
    if not sent:
        die(f"no videos, songs or pictures in {folder}")
    sent.sort(key=lambda path: natural(os.path.relpath(path, folder)))
    if found["video"] or found["audio"]:
        what = [plural(len(found[k]), w) for k, w in
                (("video", "video"), ("audio", "song")) if found[k]]
        if found["image"]:
            what.append(f"leaving out {plural(len(found['image']), 'picture')}")
    else:
        what = [plural(len(sent), "picture")]
    print(f"{folder}: {', '.join(what)}")
    return sent


def expand(targets):
    """The files and URLs to send: "-" stands for the lines on stdin,
    file:// URIs become paths, and folders the media in them."""
    out = []
    for t in targets:
        if t == "-":
            out += expand(lines(sys.stdin.read()))
            continue
        if t.lower().startswith("file://"):
            t = urllib.parse.unquote(urllib.parse.urlparse(t).path)
        elif not is_url(t) and not is_kodi_url(t):
            t = os.path.expanduser(t)
        if os.path.isdir(t):
            out += media_in(t)
        elif os.path.isfile(t) or is_url(t) or is_kodi_url(t):
            out.append(t)
        else:
            die(f"not a URL, file or folder: {t}")
    return out


def youtube_id(url):
    """The video ID of a YouTube video URL, or None (playlists included)."""
    u = urllib.parse.urlparse(url)
    host = u.netloc.lower().removeprefix("www.").removeprefix("m.")
    if host == "youtu.be":
        vid = u.path.strip("/")
    elif host in ("youtube.com", "music.youtube.com"):
        m = re.match(r"/(?:shorts|live|embed)/([^/?]+)", u.path)
        if m:
            vid = m.group(1)
        else:
            vid = urllib.parse.parse_qs(u.query).get("v", [""])[0]
    else:
        return None
    return vid if re.fullmatch(r"[\w-]{11}", vid) else None


def seconds(text):
    """90, 1:30, 1:02:03, 1h2m3s or 90s in seconds; None if it's none of those."""
    text = text.strip().lower()
    if re.fullmatch(r"\d+(:\d+){0,2}", text):
        return functools.reduce(lambda total, part: total * 60 + int(part),
                                text.split(":"), 0)
    m = re.fullmatch(r"(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", text)
    if text and m:
        h, mins, s = (int(g or 0) for g in m.groups())
        return h * 3600 + mins * 60 + s
    return None


def start_time(text):
    """argparse type for --start."""
    s = seconds(text)
    if s is None:
        raise argparse.ArgumentTypeError(
            f"not a time: '{text}' (try 90, 1:30 or 1h2m30s)")
    return s


def youtube_start(url):
    """The time a YouTube link starts at (?t=90, ?t=1m30s, #t=90), or 0."""
    u = urllib.parse.urlparse(url)
    params = {**urllib.parse.parse_qs(u.fragment), **urllib.parse.parse_qs(u.query)}
    return seconds((params.get("t") or params.get("start") or [""])[0]) or 0


USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64) send2kodi/" + VERSION


@functools.cache
def tempdir():
    """Removed when send2kodi exits."""
    path = tempfile.mkdtemp(prefix="send2kodi-")
    atexit.register(shutil.rmtree, path, True)
    return path


@functools.cache
def remote_type(url):
    """The Content-Type a URL serves, or "" if it can't be found out."""
    for method, headers in (("HEAD", {}), ("GET", {"Range": "bytes=0-0"})):
        req = urllib.request.Request(url, method=method, headers={
            "User-Agent": USER_AGENT, **headers})
        try:
            with urllib.request.urlopen(req, timeout=10) as r:
                return r.headers.get_content_type()
        except (OSError, ValueError):
            continue  # some servers refuse HEAD
    return ""


def kind_of(target):
    """What a file or link is: "video", "audio" or "image", by extension,
    which is what Kodi goes by, or for a link whose extension says nothing
    (e.g. an image proxy's /iu/?u=...), by what it serves. None for a page
    an add-on has to resolve (YouTube, or anything yt-dlp knows)."""
    if not is_url(target):  # a local file, or smb://, plugin://...
        ext = extension(urllib.parse.urlparse(target).path
                        if is_kodi_url(target) else target)
        if ext in MEDIA:
            return MEDIA[ext]
        guess = (mimetypes.guess_type(target)[0] or "").partition("/")[0]
        return guess if guess in ("audio", "image") else "video"
    if youtube_id(target):
        return None
    ext = extension(urllib.parse.urlparse(target).path)
    if ext in MEDIA or ext in STREAM_EXTS:
        return MEDIA.get(ext, "video")
    served = remote_type(target)
    if served in STREAM_TYPES:
        return "video"
    served = served.partition("/")[0]
    return served if served in ("video", "audio", "image") else None


def route(target, kind, slideshow):
    """How Kodi gets a target: "serve" (a file here), "download" (a picture
    that has to be served from here too), "direct" (a link it plays itself),
    or "youtube" / "sendtokodi" (a page that add-on resolves)."""
    if os.path.isfile(target):
        return "serve"
    if is_kodi_url(target):
        return "direct"
    if kind == "image":
        # Kodi shows pictures it recognises by extension; a slideshow is a
        # folder of ours.
        known = extension(urllib.parse.urlparse(target).path) in IMAGE_EXTS
        return "direct" if known and not slideshow else "download"
    if kind:
        return "direct"
    if (youtube_id(target) and cfg["YOUTUBE"] != "ytdlp"
            and has_addon(YOUTUBE_ADDON)):
        return "youtube"
    if not has_addon(SENDTOKODI_ADDON):
        die(f"Kodi needs the SendToKodi add-on ({SENDTOKODI_ADDON}) to play "
            f"{target}.\n  See https://github.com/firsttris/plugin.video.sendtokodi")
    return "sendtokodi"


@functools.cache
def listdir(folder):
    try:
        return sorted(os.listdir(folder))
    except OSError:
        return []


def subtitles_for(video):
    """The subtitles Kodi would find next to the video on its own disk: files
    named after it (movie.srt, movie.en.srt), beside it or in a Subs folder."""
    folder = os.path.dirname(os.path.abspath(video))
    stem = os.path.splitext(os.path.basename(video))[0].casefold()
    dirs = [folder] + [os.path.join(folder, d) for d in listdir(folder)
                       if d.casefold() in SUBTITLE_DIRS
                       and os.path.isdir(os.path.join(folder, d))]
    return [os.path.join(d, name) for d in dirs for name in listdir(d)
            if extension(name) in SUBTITLE_EXTS
            and os.path.splitext(name)[0].casefold().startswith(stem)
            and os.path.isfile(os.path.join(d, name))]


def download_image(url):
    """A local copy, named with the right extension so Kodi knows it."""
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            ext = mimetypes.guess_extension(r.headers.get_content_type()) or ".jpg"
            path = os.path.join(tempdir(), f"image{len(os.listdir(tempdir()))}{ext}")
            with open(path, "wb") as f:
                shutil.copyfileobj(r, f)
    except OSError as e:
        die(f"cannot download {url}: {e}")
    return path


# Clipboard formats, best first. A file manager offers text/uri-list; a
# browser's "Copy image" offers no text at all, only the picture and the
# image's address as text/x-moz-url (UTF-16, URL then title).
CLIP_TEXT = ["text/uri-list", "text/plain;charset=utf-8", "text/plain",
             "UTF8_STRING", "STRING", "TEXT"]
CLIP_MOZ_URL = "text/x-moz-url"


def clipboard_tool():
    """argv prefixes to list and to read the clipboard, or None to list."""
    if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-paste"):
        return ["wl-paste", "--list-types"], ["wl-paste", "--no-newline", "--type"]
    if shutil.which("xclip"):
        base = ["xclip", "-o", "-selection", "clipboard", "-t"]
        return base + ["TARGETS"], base
    if shutil.which("xsel"):
        return None, ["xsel", "-ob"]  # text only
    die("reading the clipboard needs wl-clipboard (Wayland), "
        "or xclip or xsel (X11)")


def read_clipboard(cmd):
    r = subprocess.run(cmd, capture_output=True)
    if r.returncode != 0:
        die(f"{cmd[0]}: {r.stderr.decode(errors='replace').strip() or 'cannot read the clipboard'}")
    return r.stdout


def clipboard():
    """Targets in the clipboard: URLs or paths one per line, or a copied image.

    Image data is saved to a temporary file, which is removed when send2kodi
    exits.
    """
    list_cmd, read_cmd = clipboard_tool()
    if list_cmd is None:
        types = []
        data = read_clipboard(read_cmd).decode(errors="replace")
    else:
        types = read_clipboard(list_cmd).decode(errors="replace").split()
        mime = next((t for t in CLIP_TEXT if t in types), None)
        image = next((t for t in types if t.startswith("image/")), None)
        if mime:
            data = read_clipboard(read_cmd + [mime]).decode(errors="replace")
        elif image:
            ext = mimetypes.guess_extension(image) or ".png"
            path = os.path.join(tempdir(), "clipboard" + ext)
            with open(path, "wb") as f:
                f.write(read_clipboard(read_cmd + [image]))
            return [path]
        elif CLIP_MOZ_URL in types:
            raw = read_clipboard(read_cmd + [CLIP_MOZ_URL])
            data = raw.decode("utf-16" if b"\0" in raw else "utf-8",
                              errors="replace").split("\n")[0]
        else:
            die("the clipboard holds no text or image"
                + (f" (it has: {', '.join(types)})" if types else ""))
    targets = lines(data)
    if not targets:
        die("the clipboard is empty")
    return targets


def to_kodi_file(target, kind, how, server, start=0):
    """What Kodi is given to play a target, routed as route() says; start is
    where the YouTube add-on is to start the video."""
    if how == "serve":
        return server.url_for(target, subtitles_for(target) if kind == "video" else ())
    if how == "download":
        return server.url_for(download_image(target))
    if how == "youtube":
        return (f"plugin://{YOUTUBE_ADDON}/play/?video_id={youtube_id(target)}"
                + (f"&seek={start}" if start else ""))
    if how == "sendtokodi":
        return f"plugin://{SENDTOKODI_ADDON}/?{target}"
    return target


# -------------------------------------------------------------- lifecycle --

def playlist_size(playlist):
    return rpc("Playlist.GetItems", {"playlistid": playlist})["limits"]["total"]


def playing(player):
    """The file a player is on."""
    item = rpc("Player.GetItem", {"playerid": player, "properties": ["file"]})
    return item["item"].get("file", "")


def wait_for_start(playlist, ours):
    """The id of the player once Kodi is playing what we sent, None on timeout.

    A video counts once its clock runs: Kodi knows the length of a stream
    it is still buffering, and would lose a seek to it, and a live stream
    has no length at all.
    """
    deadline = time.monotonic() + int(cfg["START_TIMEOUT"])
    while time.monotonic() < deadline:
        time.sleep(2)
        try:
            for player in rpc("Player.GetActivePlayers"):
                pid = player["playerid"]
                if playlist == PICTURE_PLAYLIST:
                    if player["type"] == "picture" and ours(playing(pid)):
                        return pid
                    continue
                props = rpc("Player.GetProperties", {
                    "playerid": pid, "properties": ["playlistid", "position", "time"]})
                t = props["time"]  # below 0 until the first frame
                if (props["playlistid"] == playlist and props["position"] >= 0
                        and (t["hours"], t["minutes"], t["seconds"], t["milliseconds"])
                        > (0, 0, 0, 0)):
                    return pid
        except KodiError:
            pass  # e.g. the player stopped between the two calls
    return None


def seek(player, s):
    """Jump to s seconds into what the player is playing."""
    try:
        rpc("Player.Seek", {"playerid": player, "value": {"time": {
            "hours": s // 3600, "minutes": s // 60 % 60, "seconds": s % 60}}})
    except KodiError as e:
        warn(f"cannot start at {s}s: {e}")


def add_subtitle(player, path, server):
    """Load a subtitle file into the player, which shows it."""
    url = server.url_for(path)
    try:
        rpc("Player.AddSubtitle", {"playerid": player, "subtitle": url})
    except KodiError as e:
        warn(f"Kodi did not take the subtitles: {e}")
        return
    server.wait_fetched(url)  # Kodi reads it once, but not right away


def wait_until_done(ours, playlist, started):
    """Serve until playback has ended, or our files have left the queue.

    Queued files may wait a long time for their turn, so idle time alone
    doesn't end the run, until something has started playing. A slideshow
    fetches each picture as it gets to it, so pictures are served until the
    viewer moves off them: closed, or showing something someone else sent.
    Kodi has no player for a moment between two items, and may stop
    answering for a while (Wi-Fi), so neither ends the run straight away.
    """
    print("Serving local file(s) until playback ends (Ctrl-C to quit)...")
    idle, answered = 0, time.monotonic()
    try:
        while True:
            time.sleep(5)
            try:
                players = rpc("Player.GetActivePlayers")
            except (KodiError, Unreachable):
                if time.monotonic() - answered > 120:
                    return
                continue
            answered = time.monotonic()
            if players:
                started, idle = True, 0
            elif started:
                idle += 1
                if idle >= 2:
                    return
                continue
            try:
                if started and playlist == PICTURE_PLAYLIST:
                    viewer = [p for p in players if p["type"] == "picture"]
                    if not viewer or not ours(playing(viewer[0]["playerid"])):
                        return
                    continue
                items = rpc("Playlist.GetItems", {"playlistid": playlist,
                                                  "properties": ["file"]})
                if not any(ours(i.get("file", "")) for i in items.get("items", [])):
                    return
            except (KodiError, Unreachable):
                pass  # e.g. the viewer closed between the two calls
    except KeyboardInterrupt:
        pass


def background():
    """Fork a detached child that carries on; the parent relays its startup.

    The child's output goes through a pipe until it calls detached(); the
    parent prints it and exits 0 then, or with the child's own exit status if
    it dies first (e.g. playback never started).
    """
    r, w = os.pipe()
    pid = os.fork()
    if pid:
        os.close(w)
        out = b""
        while chunk := os.read(r, 4096):
            out += chunk
        ok = out.endswith(b"\0")
        sys.stdout.write(out.rstrip(b"\0").decode(errors="replace"))
        sys.stdout.flush()
        if ok:
            os._exit(0)
        _, status = os.waitpid(pid, 0)
        os._exit(os.waitstatus_to_exitcode(status))
    os.close(r)
    os.setsid()
    os.dup2(w, 1)
    os.dup2(w, 2)
    os.close(w)


def detached():
    """Tell the parent we're up, then drop the pipe (see background())."""
    os.write(1, b"\0")
    null = os.open(os.devnull, os.O_RDWR)
    os.dup2(null, 0)
    os.dup2(null, 1)
    os.dup2(null, 2)


# ------------------------------------------------------------------- main --

def main():
    p = argparse.ArgumentParser(
        description="Send URLs, local files and folders to Kodi.",
        epilog=f"Settings file: {CONFIG_PATH}. Every setting there "
               "(KODI_HOST, KODI_PORT, ...) also works as an environment "
               "variable.")
    p.add_argument("targets", nargs="*", metavar="URL_OR_FILE",
                   help="URLs (YouTube, anything yt-dlp supports, links to "
                        "media files and streams), files or folders; - reads "
                        "them from stdin, one per line")
    p.add_argument("-q", "--queue", action="store_true",
                   help="append to Kodi's queue instead of playing now")
    p.add_argument("-C", "--clipboard", action="store_true",
                   help="also send the URLs or file paths in the clipboard, "
                        "one per line")
    p.add_argument("-s", "--start", type=start_time, metavar="TIME",
                   help="start the first item at TIME (90, 1:30, 1h2m30s)")
    p.add_argument("--sub", metavar="FILE",
                   help="show FILE as subtitles for the first video (those "
                        "named after a local video, like movie.en.srt, are "
                        "found anyway)")
    p.add_argument("--bg", action="store_true", default=None,
                   help="serve local files from a background process")
    p.add_argument("--fg", dest="bg", action="store_false",
                   help="stay in the foreground (overrides BACKGROUND=yes)")
    p.add_argument("--ytdlp", action="store_true",
                   help="play YouTube links through yt-dlp, not the YouTube add-on")
    p.add_argument("--stop", action="store_true", help="stop playback")
    p.add_argument("--pause", action="store_true", help="toggle pause")
    p.add_argument("-H", "--host", help="Kodi address (KODI_HOST)")
    p.add_argument("-p", "--port", help="Kodi web server port (KODI_PORT)")
    p.add_argument("-c", "--config", default=CONFIG_PATH,
                   help="settings file (default: %(default)s)")
    p.add_argument("--version", action="version", version=f"send2kodi {VERSION}")
    args = p.parse_args()
    # Exit normally on kill too, so temporary files are cleaned up.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))

    cfg.update(read_config(args.config))
    cfg.update({k: os.environ[k] for k in DEFAULTS if k in os.environ})
    if args.host:
        cfg["KODI_HOST"] = args.host
    if args.port:
        cfg["KODI_PORT"] = args.port
    if args.ytdlp:
        cfg["YOUTUBE"] = "ytdlp"
    if not cfg["KODI_HOST"]:
        die(f"no Kodi configured. Run the installer, pass --host, or set "
            f"KODI_HOST in {args.config}")

    if args.stop or args.pause:
        for player in rpc("Player.GetActivePlayers"):
            method = "Player.Stop" if args.stop else "Player.PlayPause"
            rpc(method, {"playerid": player["playerid"]})
        return
    targets = expand(args.targets + (clipboard() if args.clipboard else []))
    if not targets:
        p.error("nothing to send")
    if args.sub and not os.path.isfile(args.sub):
        p.error(f"no such file: {args.sub}")
    kinds = [kind_of(t) for t in targets]
    if "image" in kinds and set(kinds) != {"image"}:
        p.error("pictures can't be sent together with videos or music")
    playlist = (PICTURE_PLAYLIST if "image" in kinds else
                MUSIC_PLAYLIST if set(kinds) == {"audio"} else VIDEO_PLAYLIST)
    if (args.start or args.sub) and (args.queue or playlist == PICTURE_PLAYLIST):
        p.error("--start and --sub are for videos and music played now, "
                "not with -q or for pictures")
    # Kodi answers OK to adding pictures to an open slideshow, but drops them.
    if args.queue and playlist == PICTURE_PLAYLIST and any(
            p["type"] == "picture" for p in rpc("Player.GetActivePlayers")):
        die("Kodi can't add pictures to a slideshow that is already showing. "
            "Leave it, or send them without -q to replace it.")
    # Several pictures are shown as a folder of ours, which Kodi reads as it
    # is; added to a slideshow one by one, those it can't read EXIF data from
    # (PNGs, ...) are dropped.
    slideshow = (playlist == PICTURE_PLAYLIST and len(targets) > 1
                 and not args.queue and not any(map(is_kodi_url, targets)))
    routes = [route(t, k, slideshow) for t, k in zip(targets, kinds)]
    served = any(how in ("serve", "download") for how in routes)

    bg = args.bg if args.bg is not None else truthy(cfg["BACKGROUND"])
    bg = bg and (served or args.sub is not None)
    if bg:
        background()
        print(f"Serving local file(s) in the background (pid {os.getpid()}).")

    def start_of(i, target):
        """Where an item starts: --start for the first, else its link's ?t=."""
        if i == 0 and args.start is not None:
            return args.start
        return youtube_start(target) if youtube_id(target) else 0

    server = Server()
    if slideshow:
        paths = [t if how == "serve" else download_image(t)
                 for t, how in zip(targets, routes)]
        # Numbered, as Kodi sorts a slideshow by name.
        width = len(str(len(paths)))
        files = [server.folder({f"{n:0{width}} {os.path.basename(path)}": path
                                for n, path in enumerate(paths, 1)})]
        rpc("Player.Open", {"item": {"path": files[0], "recursive": False},
                            "options": {"shuffled": False}})
    else:
        files = [to_kodi_file(t, k, how, server, start_of(i, t))
                 for i, (t, k, how) in enumerate(zip(targets, kinds, routes))]
        if playlist == PICTURE_PLAYLIST and len(files) == 1 and not args.queue:
            # Straight to the viewer: Kodi drops PNGs added to a slideshow.
            rpc("Player.Open", {"item": {"file": files[0]}})
        else:
            if not args.queue:
                # Whatever is playing goes first: it would pass for ours
                # while an add-on is still resolving ours.
                for player in rpc("Player.GetActivePlayers"):
                    if player["type"] != "picture":
                        rpc("Player.Stop", {"playerid": player["playerid"]})
                rpc("Playlist.Clear", {"playlistid": playlist})
            # Kodi adds pictures there and then, dropping some; videos and
            # songs a moment later, all of them.
            before = playlist_size(playlist) if playlist == PICTURE_PLAYLIST else 0
            rpc("Playlist.Add", {"playlistid": playlist,
                                 "item": [{"file": f} for f in files]})
            if playlist == PICTURE_PLAYLIST:
                added = playlist_size(playlist) - before
                if added < len(files):
                    die(f"Kodi accepted only {added} of {len(files)} picture(s). "
                        "It drops PNGs added to a slideshow; send them without -q.")
            if not args.queue:
                rpc("Player.Open", {"item": {"playlistid": playlist, "position": 0}})
    sent = set(files)

    def ours(file):
        """Served from here, or a picture we sent to the slideshow."""
        return server.owns(file) or (playlist == PICTURE_PLAYLIST and file in sent)

    if args.queue:
        print(f"Queued {plural(len(targets), 'item')}.")
    else:
        subs = f" with {plural(server.extras, 'subtitle file')}" if server.extras else ""
        print(f"Sent {plural(len(targets), 'item')}{subs} to {cfg['KODI_HOST']}, "
              "waiting for playback...")
        player = wait_for_start(playlist, ours)
        if player is None:
            die(f"nothing started playing after {cfg['START_TIMEOUT']}s; "
                "the link may be unsupported or failed to resolve")
        print("Playing.")
        start = start_of(0, targets[0])
        if start and routes[0] != "youtube":  # that add-on seeks by itself
            seek(player, start)
        if args.sub:
            add_subtitle(player, args.sub, server)
    if bg:
        detached()
    if served:
        wait_until_done(ours, playlist, started=not args.queue)


if __name__ == "__main__":
    try:
        main()
    except (KodiError, Unreachable) as e:
        die(e)
    except KeyboardInterrupt:
        print(file=sys.stderr)  # end the line the terminal's ^C is on
        sys.exit(130)
